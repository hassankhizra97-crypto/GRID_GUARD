<h3>8.2 Key Code Snippets</h3>

<h4>8.2.1 Fault Priority Score Calculation (Fault.h:40-45)</h4>
<div class="code-block>
void Fault::calculatePriority() {
    priorityScore = (severity * 10.0)
                  + (criticalFacilitiesAffected * 20.0)
                  + (static_cast<double>(populationAffected) / 100.0)
                  + (outageDuration * 2.0);
}
</div>

<h4>8.2.2 BFS Traversal (Graph.cpp:267-298)</h4>
<div class="code-block>
void Graph::runBFS(int startVertexId, CustomVector<int>& reachableLocations, bool onlyOperational) const {
    reachableLocations.clear();
    if (startVertexId < 0 || startVertexId >= MAX_VERTICES || !locationExists[startVertexId]) {
        return;
    }

    bool visited[MAX_VERTICES] = {false};
    CircularQueue<int> q(MAX_VERTICES);

    visited[startVertexId] = true;
    q.enqueue(startVertexId);

    while (!q.isEmpty()) {
        int u = q.dequeue();
        reachableLocations.push_back(u);

        AdjEdgeNode* curr = adjList[u];
        while (curr != nullptr) {
            int v = curr->neighborLocationId;
            bool canTraverse = true;
            if (onlyOperational) {
                canTraverse = isPowerLineOperational(curr->powerLineId);
            }

            if (canTraverse && !visited[v] && locationExists[v]) {
                visited[v] = true;
                q.enqueue(v);
            }
            curr = curr->next;
        }
    }
}
</div>

<h4>8.2.3 Dijkstra's Algorithm (RoadNetwork.cpp:86-168)</h4>
<div class="code-block>
bool RoadNetwork::findShortestPath(int startId, int targetId,
                                   CustomVector<int>& pathOut, double& totalCostOut) const {
    pathOut.clear();
    totalCostOut = 0.0;

    const double INF = 1e9;
    double dist[MAX_VERTICES];
    bool visited[MAX_VERTICES];
    int parent[MAX_VERTICES];

    for (int i = 0; i < MAX_VERTICES; ++i) {
        dist[i] = INF;
        visited[i] = false;
        parent[i] = -1;
    }

    dist[startId] = 0.0;

    for (int count = 0; count < MAX_VERTICES; ++count) {
        double minVal = INF;
        int u = -1;
        for (int v = 0; v < MAX_VERTICES; ++v) {
            if (vertexExists[v] && !visited[v] && dist[v] < minVal) {
                minVal = dist[v];
                u = v;
            }
        }

        if (u == -1 || minVal >= INF) break;
        visited[u] = true;
        if (u == targetId) break;

        RoadEdgeNode* edge = adjList[u];
        while (edge != nullptr) {
            int v = edge->toLocationId;
            if (!visited[v]) {
                double newDist = dist[u] + edge->travelMinutes;
                if (newDist < dist[v]) {
                    dist[v] = newDist;
                    parent[v] = u;
                }
            }
            edge = edge->next;
        }
    }

    if (dist[targetId] >= INF) return false;

    totalCostOut = dist[targetId];
    CustomVector<int> reversePath;
    int curr = targetId;
    while (curr != -1) {
        reversePath.push_back(curr);
        curr = parent[curr];
    }

    for (int i = static_cast<int>(reversePath.size()) - 1; i >= 0; --i) {
        pathOut.push_back(reversePath[i]);
    }

    return true;
}
</div>

<h4>8.2.4 Max-Heap Insert and ExtractMax (MaxHeap.h:94-114)</h4>
<div class="code-block>
void MaxHeap::insert(const Fault& fault) {
    if (heapSize >= capacity) {
        resize(capacity * 2);
    }
    heap[heapSize] = fault;
    heapifyUp(heapSize);
    heapSize++;
}

Fault MaxHeap::extractMax() {
    if (isEmpty()) {
        throw std::runtime_error("Cannot extractMax from an empty Max-Heap");
    }
    Fault maxItem = heap[0];
    heap[0] = heap[heapSize - 1];
    heapSize--;
    if (heapSize > 0) {
        heapifyDown(0);
    }
    return maxItem;
}
</div>

